#include "resource.h"

// The banner artwork, made from assets/banner_source.jpg by
// tools/make_banner.py and decoded at startup through WIC (see banner.h).
IDR_BANNER RCDATA "assets/banner.jpg"

// The taskbar/Explorer icon: the hero's face cropped out of the same artwork
// by tools/make_icon.py. The lowest-numbered icon resource is the one
// Explorer shows for the file, and IDI_APPICON is the only one here.
IDI_APPICON ICON "assets/soul_of_darkness.ico"

// The application manifest: visual styles for the owner-drawn buttons'
// focus/frame metrics, and per-monitor DPI so the artwork is resampled at
// the monitor's real density instead of being stretched by the compositor.
//
// Embedded here rather than passed to the linker with /MANIFESTINPUT: CMake
// wraps the link in `cmake -E vs_link_exe`, which runs mt.exe with its own
// (empty) manifest list and fails. Supplying it as a resource and turning
// CMake's generated manifest off with /MANIFEST:NO keeps one RT_MANIFEST.
//
// 1 is CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 is RT_MANIFEST.
1 24 "launcher.manifest"
