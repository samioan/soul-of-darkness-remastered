#pragma once

// Generated into the build directory by soul/port/CMakeLists.txt's
// configure_file. The value comes from the `SOD_VERSION` cache variable,
// which a local build leaves at its "-dev" default and which the release
// workflow sets from the git tag (with the "v" stripped) -- so what the
// launcher shows in its corner is always the build it actually is.
//
// The same value decides whether this build offers updates at all. A "-dev"
// version does not (see updater.h): its install is a build tree, and
// dropping a release on top of it would overwrite work in progress.

#define SOD_LAUNCHER_VERSION "@SOD_VERSION@"
#define SOD_LAUNCHER_VERSION_W L"@SOD_VERSION@"

// Where the launcher looks for newer builds (see update_check.h). Cache
// variables so a fork updates from its own repository without editing source.
#define SOD_UPDATE_OWNER "@SOD_UPDATE_OWNER@"
#define SOD_UPDATE_REPO "@SOD_UPDATE_REPO@"
#define SOD_UPDATE_TAG_PREFIX "@SOD_UPDATE_TAG_PREFIX@"
